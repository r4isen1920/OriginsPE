{
	"$scope": {
		"items": [
			"smithing_netherite_axe",
			"smithing_netherite_boots",
			"smithing_netherite_chestplate",
			"smithing_netherite_helmet",
			"smithing_netherite_hoe",
			"smithing_netherite_leggings",
			"smithing_netherite_pickaxe",
			"smithing_netherite_shovel",
			"smithing_netherite_sword",
			"smithing_netherite_spear"
		]
	},

	"$files": {
		"array": "listLatestBPFiles('recipes').filter(x => items.contains(fileBaseName(x)))",
		"filename": "{{fileBaseName(value)}}"
	},
	"$copy": "{{value}}",

	"$template": {
		"format_version": "1.20.10",
		"minecraft:recipe_smithing_transform": {
			"description": {
				"identifier": "r4isen1920_originspe:enhanced_{{fileBaseName(value)}}"
			},
    		"base": "r4isen1920_originspe:enhanced_{{replace(fileBaseName(value), 'smithing_netherite_', 'diamond_')}}",
			"result": "r4isen1920_originspe:enhanced_{{replace(fileBaseName(value), 'smithing_', '')}}"
		}
	}
}
