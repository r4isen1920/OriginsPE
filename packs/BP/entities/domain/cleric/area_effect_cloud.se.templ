{
	"$template": {
		"format_version": "1.21.0",
		"minecraft:entity": {
			"description": {
				"identifier": "r4isen1920_originspe:cleric_area_effect_cloud",

				"is_summonable": true,
				"is_spawnable": false,

				"properties": {
					//* Carried so the cloud's particle tint can be resolved without a
					//* script lookup on every stage tick.
					"r4isen1920_originspe:potion": {
						"type": "int",
						"range": [0, "{{=count(cleric_potions) - 1}}"],
						"client_sync": true,
						"default": 0
					}
				}
			},

			"components": {
				"minecraft:type_family": {
					"family": ["cleric_control", "potion", "origins", "inanimate"]
				},

				"minecraft:collision_box": {
					"width": 0.0,
					"height": 0.0
				},

				"minecraft:physics": {},

				"minecraft:pushable": {
					"is_pushable": false,
					"is_pushable_by_piston": true
				},

				//? Immune to everything: it is a marker, not a target.
				"minecraft:damage_sensor": {
					"triggers": {
						"cause": "all",
						"deals_damage": "no"
					}
				},

				"minecraft:conditional_bandwidth_optimization": {
					"default_values": {
						"max_optimized_distance": 80.0,
						"max_dropped_ticks": 5,
						"use_motion_prediction_hints": true
					}
				}
			}
		}
	}
}
