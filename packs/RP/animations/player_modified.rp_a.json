{
	"format_version" : "1.8.0",
	"animations" : {

		"animation.r4isen1920_originspe.shulk_inv.standing": {
			"loop": true,
			"bones": {
				"root": {
					"position": [ 0.0, "-(variable.riding_y_offset ?? 0.0)", 0.0 ]
				},
				"leftarm": {
					"rotation": [ 36.0, 0.0, 0.0 ]
				},
				"rightarm": {
					"rotation": [ 36.0, 0.0, 0.0 ]
				},
				"leftleg": {
					"rotation": [ 81.0, 18.0, 0.0 ]
				},
				"rightleg": {
					"rotation": [ 81.0, -18.0, 0.0 ]
				}
			}
		},

		"animation.player.first_person.base_pose": {
			"loop": true,
			"bones": {
				"rightarm": {
					"position": [ "q.variant == 14 ? 50.0 : 0.0", 0, "(q.variant == 11 ? 4.0 : (q.variant == 14 ? 90.0 : 0.0))" ]
				},
				"body": {
					"rotation": [ "query.target_x_rotation", "query.target_y_rotation", 0.0 ]
				},
				"head": {
					"rotation": [ "query.target_x_rotation", "query.target_y_rotation + 180", 0.0 ]
				}
			}
		},

		"animation.player.cape": {
			"loop": true,
			"bones": {
				"cape": {
					"position": [ 0.0, "query.get_root_locator_offset('armor_offset.default_neck', 1)", 0.0 ],
					"rotation": [ "math.lerp(0.0, -126.0, query.cape_flap_amount) - 6.0", 0.0, 0.0 ],
					"scale": "v.p_model_type == 'bat' ? 0 : 1"
				}
			}
		}
	}
}