{
	"$template": {
		"resource_pack_name": "origins",
		"texture_name": "atlas.items",
		"texture_data": {
			"r4isen1920_originspe:orb_of_origins": {
				"textures": ["textures/origins/items/orb"]
			},
			"r4isen1920_originspe:resignation_paper": {
				"textures": ["textures/origins/items/resignation_paper"]
			},

			"{{#(blacksmith_tools).filter(b => b.type != 'spear' && b.material != 'leather') as bt}}": {
				"{{bt.material != null ? (bt.material + '_' + bt.type) : bt.type}}": {
					"textures": [
						{
							"{{?bt.type != 'bow'}}": "textures/items/{{bt.material != null ? ((bt.material == 'golden' ? 'gold' : (bt.material == 'wooden' ? 'wood' : bt.material)) + '_' + bt.type) : bt.type}}"
						},
						{
							"{{?bt.type == 'bow'}}": "textures/items/{{bt.type}}_standby"
						}
					]
				}
			},

			"{{#(blacksmith_tools).filter(b => b.material == 'leather') as bt}}": {
				"leather_{{bt.type}}_default": {
					"textures": [
						"textures/items/leather_{{type}}_default"
					]
				},
				"leather_{{bt.type}}_dyed": {
					"textures": [
						"textures/items/leather_{{type}}"
					]
				}
			},

			"{{#cleric_potion_deliveries as d}}": {
				"{{#cleric_potions as p}}": {
					"r4isen1920_originspe:{{d.texture}}_{{p.texture}}": {
						"textures": [
							"textures/items/{{d.texture}}_{{p.texture}}"
						]
					}
				}
			}
		}
	}
}
