{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "r4isen1920_originspe:bloodthirsty_bleed",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "variable.size = 0.1;variable.lifetime = 2;",
				"per_update_expression": "variable.ysize = !q.is_sneaking ? 1 : 0.8;"
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": "math.min((v.particle_count ?? 1) * 5, 128)"
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 1
			},
			"minecraft:emitter_shape_box": {
				"offset": [0, "v.size.y*1.5", 0],
				"half_dimensions": ["v.size.x", "v.size.y", "v.size.z"],
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.25,0.75)*10"
			},
			"minecraft:particle_initial_speed": 3,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": ["math.random(1,-1)", "math.random(-1,-5)*10", "math.random(1,-1)"],
				"linear_drag_coefficient": "6 - math.max(v.particle_count / 12, 3)"
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["(0.125*(v.particle_random_1+0.1))*2", "(0.125*(v.particle_random_1+0.1))*2"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"flipbook": {
						"base_UV": [56, 0],
						"size_UV": [8, 8],
						"step_UV": [-8, 0],
						"frames_per_second": 1,
						"max_frame": 8,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 1,
				"collision_radius": 0.1
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "variable.particle_age",
					"gradient": {
						"0.49": "#FC7F1C1C",
						"1.0": "#FF751111"
					}
				}
			}
		}
	}
}