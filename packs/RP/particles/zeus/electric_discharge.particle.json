{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "r4isen1920_originspe:electric_discharge",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/origins/particles/glow_pixel"
			}
		},
		"curves": {
			"variable.opacity": {
				"type": "bezier",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [0, 1, 0.2, 0]
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "variable.lifetime = 1;",
				"per_update_expression": "variable.size = math.random(0.7,0.9);"
			},
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": true
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": "v.count * 5"
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 1
			},
			"minecraft:emitter_shape_disc": {
				"offset": [0, "v.size.y", 0],
				"radius": "v.size.x * v.size.z * 1.6",
				"surface_only": true,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "variable.particle_random_1*variable.emitter_lifetime"
			},
			"minecraft:particle_initial_speed": "math.random(2,5)",
			"minecraft:particle_motion_dynamic": {
				"linear_drag_coefficient": 4
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["variable.size*(variable.particle_random_1*variable.lifetime-variable.particle_age)*2.5", "variable.size*(variable.particle_random_1*variable.lifetime-variable.particle_age)*2.5"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 32,
					"texture_height": 32,
					"uv": [0, 0],
					"uv_size": [32, 32]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime * math.random(0, 1.5)",
					"gradient": {
						"0.0": "#FFFFFFFA",
						"0.2": "#FF4BE6FF",
						"1.0": "#00000000"
					}
				}
			}
		}
	}
}