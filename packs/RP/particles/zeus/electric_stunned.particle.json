{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "r4isen1920_originspe:electric_stunned",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/origins/particles/glow_fireworks"
			}
		},
		"curves": {
			"variable.opacity": {
				"type": "bezier",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [0, 1, 0.2, 0]
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "variable.lifetime = 1;",
				"per_update_expression": "variable.size = math.random(0.6,0.7);"
			},
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": true
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 100,
				"max_particles": 42
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": "v.duration"
			},
			"minecraft:emitter_shape_box": {
				"offset": [0, "v.size.y*1.5", 0],
				"half_dimensions": ["v.size.x", "v.size.y", "v.size.z"],
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "variable.particle_random_1*variable.emitter_lifetime"
			},
			"minecraft:particle_initial_speed": "math.random(2,4)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, "Math.random(-1.0, -2.0)*2", 0],
				"linear_drag_coefficient": 7
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["variable.size*(variable.particle_random_1*variable.lifetime-variable.particle_age)*1.5", "variable.size*(variable.particle_random_1*variable.lifetime-variable.particle_age)*1.5"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 256,
					"texture_height": 30,
					"flipbook": {
						"base_UV": [192, 0],
						"size_UV": [32, 30],
						"step_UV": [-1, 0],
						"frames_per_second": 2,
						"max_frame": 8,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 1,
				"collision_radius": 0.1
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime * math.random(0, 1.5)",
					"gradient": {
						"0.0": "#FFFFFFFA",
						"0.2": "#FF4BE6FF",
						"1.0": "#00000000"
					}
				}
			}
		}
	}
}