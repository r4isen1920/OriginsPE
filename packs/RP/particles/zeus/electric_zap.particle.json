{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "r4isen1920_originspe:electric_zap",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/origins/particles/glow_fireworks"
			}
		},
		"curves": {
			"variable.opacity": {
				"type": "bezier",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [0, 1, 0.2, 0]
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "variable.lifetime = 1;",
				"per_update_expression": "variable.size = math.random(0.2,0.3);"
			},
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": true
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": 50
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 1
			},
			"minecraft:emitter_shape_sphere": {
				"offset": [0, 0.3, 0],
				"radius": 0.8,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "variable.particle_random_1*variable.emitter_lifetime"
			},
			"minecraft:particle_initial_speed": 1,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, "Math.random(-1.0, -2.0)", 0],
				"linear_drag_coefficient": 1
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["variable.size*(variable.particle_random_1*variable.lifetime-variable.particle_age)", "variable.size*(variable.particle_random_1*variable.lifetime-variable.particle_age)"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 256,
					"texture_height": 30,
					"flipbook": {
						"base_UV": [192, 0],
						"size_UV": [32, 30],
						"step_UV": [-1, 0],
						"frames_per_second": 2,
						"max_frame": 8,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFFFFFA",
						"0.2": "#FF4BE6FF",
						"1.0": "#00000000"
					}
				}
			}
		}
	}
}