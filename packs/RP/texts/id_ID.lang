pack.name=§7[v6.0]§r OriginsPE [RP]
pack.description=Add-On ini menambahkan beberapa Origin dan Kelas dengan kemampuan pasif ke dalam permainan, yang dapat kamu pilih saat memulai petualanganmu. Dibuat oleh r4isen1920.

origins.welcome_message=§eSelamat datang kembali!§r UI Add-On OriginsPE telah berhasil dimuat.
origins.changelog_message=[Gulir ke bawah untuk info lebih lanjut]
origins.patch_notes.title=v6.0 Rilis
origins.patch_notes.content=Pembaruan ini menghadirkan dua Origin baru yang dapat dimainkan, satu Kelas baru untuk dipilih! Beberapa perombakan Origin, dan penyesuaian keseimbangan. Ditambah peningkatan gameplay secara umum, dan perbaikan bug.\n\nUntuk mempelajari lebih lanjut, silakan lihat §eOpsi > Catatan pembaruan§r.
origins.contributors.title=Kontributor

origins.random.name=Acak
origins.random.description=Kamu akan ditugaskan ke salah satu dari yang terdaftar di bawah ini, hanya jika tersedia untuk digunakan:
origins.random.description_changed=Kamu akan ditugaskan ke mana saja yang tersedia.

origins.human.name=Manusia
origins.human.description=Manusia biasa. Pengalaman Minecraft biasamu telah menanti.
origins.merling.name=Merling
origins.merling.description=Penghuni alami samudra ini tidak terbiasa berada di luar air terlalu lama.
origins.arachnid.name=Arachnid
origins.arachnid.description=Kemampuan memanjat mereka dan kemampuan untuk menjebak musuh dalam sarang laba-laba membuat Arachnid menjadi pemburu yang sempurna.
origins.blazeborn.name=Blazeborn
origins.blazeborn.description=Keturunan akhir dari Blaze, Blazeborn secara alami kebal terhadap bahaya di Nether.
origins.avian.name=Avian
origins.avian.description=Ras Avian telah kehilangan kemampuan terbang mereka sejak lama. Kini makhluk damai ini dapat terlihat meluncur dari satu tempat ke tempat lain.
origins.phantom.name=Phantom
origins.phantom.description=Sebagai keturunan setengah manusia dan setengah phantom, makhluk ini dapat berganti antara wujud Phantom dan wujud normal.
origins.feline.name=Feline
origins.feline.description=Dengan penampilan seperti kucing, Feline menakuti creeper. Dengan kelincahan kucing, mereka selalu mendarat dengan aman di atas kaki mereka.
origins.elytrian.name=Elytrian
origins.elytrian.description=Sering terbang di tengah angin, Elytrian merasa tidak nyaman ketika tidak memiliki cukup ruang di atas kepala mereka.
origins.enderian.name=Enderian
origins.enderian.description=Lahir sebagai putra dan putri dari Naga Ender, Enderian mampu berpindah tempat tetapi rentan terhadap air.
origins.shulk.name=Shulk
origins.shulk.description=Kerabat dari Shulker, tubuh Shulk dilengkapi dengan kulit pelindung mirip cangkang.
origins.kitsune.name=Rubah
origins.kitsune.description=Rubah, meskipun lemah dalam hal vitalitas, memanfaatkan kemampuan spiritual bawaan mereka untuk bersembunyi dan memperkuat kekuatan mereka.
origins.slimecican.name=Slimecican
origins.slimecican.description=Setengah manusia, setengah slime. Sangat tidak menyenangkan untuk disentuh dengan tangan kosong.
origins.starborne.name=Starborne
origins.starborne.description=Lahir dari bintang-bintang, kamu adalah pribadi yang non-kekerasan, terobsesi dengan bintang, misterius, dan berpotensi kuat yang jatuh dari bintang ke dunia kotak-kotak ini.
origins.inchling.name=Inchling
origins.inchling.description=Keturunan dari suku terkecil, makhluk-makhluk ini selincah ukuran tubuh mereka.
origins.bee.name=Lebah
origins.bee.description=Lebah itu keren. Mereka terbang, menikmati bunga, dan mati.
origins.piglin.name=Piglin
origins.piglin.description=Ras dominan di Nether, makhluk humanoid ini menggunakan otot kasar mereka dan membanggakan emas mereka.
origins.elf.name=Elven
origins.elf.description=Makhluk anggun dan lincah dengan hubungan mendalam terhadap alam, terampil dalam memanah, yang telah mereka asah berkat usia harapan hidup mereka yang panjang.
origins.voidwalker.name=Voidwalker
origins.voidwalker.description=Lahir di kedalaman alam yang menyeramkan, kamu telah memperoleh kemampuan untuk memanipulasi dan memanfaatkan energi gelap dari dalam untuk menyakiti orang lain.
origins.diviner.name=Diviner
origins.diviner.description=Diviner memiliki kemampuan untuk memanfaatkan energi mistis alam semesta, menggunakannya untuk melindungi dan membantu pemain lain yang membutuhkan.
origins.mole.name=Tikus Mondok
origins.mole.description=Lahir untuk menggali, kamu berkembang di dalam kegelapan dan membenci permukaan yang disinari matahari. Kedalaman adalah domain sejatimu.
origins.rootkin.name=Rootkin
origins.rootkin.description=Petarung bentukan alam yang mengikat musuh dengan akar, mengalihkan kerusakan, dan menjadi lebih kuat di setiap pertarungan--tidak mampu menggunakan senjata maupun menahan api.
origins.zeus.name=Anak Zeus
origins.zeus.description=Keturunan dari Dewa petir yang agung, mampu mengendalikan petir itu sendiri.
origins.vampire.name=Vampir
origins.vampire.description=Memanfaatkan adaptasi sensorik yang tajam dan kemampuan melacak darah, mereka unggul dalam berburu target lintas dimensi dan membalikkan daya hidup mangsa mereka untuk melawan mereka sendiri.

origins.nitwit.name=Nitwit
origins.nitwit.description=Nitwit tidak benar-benar ahli dalam hal apa pun. Kamu akan melanjutkan tanpa keahlian tambahan.
origins.warrior.name=Prajurit
origins.warrior.description=Petarung terhormat ini memiliki keberanian besar untuk menumbangkan musuh-musuh mereka.
origins.archer.name=Pemanah
origins.archer.description=Satu tembakan, satu tewas. Mampu menumbangkan target dari jarak jauh.
origins.rogue.name=Rogue
origins.rogue.description=Biasanya dikenal sebagai pencuri dan perampok, rogue mahir dalam penyergapan dan serangan tersembunyi.
origins.beastmaster.name=Beastmaster
origins.beastmaster.description=Beastmaster adalah orang-orang menyendiri yang lebih menyukai teman hewan.
origins.blacksmith.name=Pandai Besi
origins.blacksmith.description=Teman yang berharga bagi siapa saja, Pandai Besi mampu membuat alat, senjata, dan zirah yang lebih baik.
origins.cleric.name=Klerik
origins.cleric.description=Mereka telah mempelajari cara menyalurkan sihir yang ada di dunia dan menggunakannya untuk keuntungan mereka.
origins.cook.name=Koki
origins.cook.description=Tidak ada yang lebih baik dalam menyiapkan makananmu selain seorang Koki.
origins.farmer.name=Petani
origins.farmer.description=Petani telah dikenal menyediakan makanan untuk semua orang sejak waktu yang tidak dapat diingat.
origins.merchant.name=Pedagang
origins.merchant.description=Selalu mencari zamrud tambahan, Pedagang adalah pebisnis yang mahir.
origins.rancher.name=Peternak
origins.rancher.description=Memanfaatkan hewan semaksimal mungkin, Peternak mampu mengumpulkan banyak sumber daya berguna.
origins.miner.name=Penambang
origins.miner.description=Penambang adalah yang paling mahir dalam menggali harta karun bumi.
origins.lumberjack.name=Penebang Pohon
origins.lumberjack.description=Pohon-pohon harus berhati-hati saat Penebang Pohon berada di sekitar.
origins.explorer.name=Penjelajah
origins.explorer.description=Penjelajah menemukan jalan mereka melalui medan yang paling sulit dengan mudah dan menemukan tempat penting yang tersembunyi.
origins.athlete.name=Atlet
origins.athlete.description=Kelas dengan mobilitas tinggi yang unggul dalam kecepatan dan stamina.


origins.trait.water_breathing.name=Insang
origins.trait.water_breathing.description=Kamu dapat bernapas di dalam air, tetapi tidak di darat. Namun, efek status seperti bernapas dalam air dapat membantumu dalam petualanganmu.
origins.trait.aqua_affinity.name=Afinitas Air
origins.trait.aqua_affinity.description=Kamu dapat menghancurkan blok di bawah air seperti yang dilakukan orang lain di darat, dan dapat melihat dengan sempurna di bawah air.
origins.trait.sea_creature.name=Penghuni Laut
origins.trait.sea_creature.description=Mob bawah air secara alami tidak akan menyakiti atau menyerangmu, kecuali jika kamu menyerang mereka terlebih dahulu.
origins.trait.like_water.name=Seperti Air
origins.trait.like_water.description=Kamu secara alami tetap mengapung di atas air, dan tenggelam dengan berjongkok kapan pun kamu mau.
origins.trait.no_trident_damage.name=Anugerah Samudra
origins.trait.no_trident_damage.description=Kamu kebal dari kerusakan yang disebabkan oleh trisula.
origins.trait.fragile.name=Rentan
origins.trait.fragile.description=Kamu memiliki kesehatan 3 hati lebih sedikit daripada manusia.
origins.trait.webbing.name=Jaring Laba-laba
origins.trait.webbing.description=Saat kamu mengenai musuh dalam jarak dekat, mereka sementara terjebak dalam sarang laba-laba. Memiliki jeda 13 detik.
origins.trait.master_of_webs.name=Ahli Sarang
origins.trait.master_of_webs.description=Kamu dapat melintasi sarang laba-laba tanpa diperlambat.
origins.trait.climbing.name=Memanjat
origins.trait.climbing.description=Kamu dapat memanjat blok padat apa pun yang kamu lihat dengan cepat sambil menahan tombol lompat. Jatuh saat memanjat mengurangi kerusakan jatuh yang diterima.
origins.trait.carnivore.name=Karnivora
origins.trait.carnivore.description=Dietmu terbatas pada daging, dan kamu tidak akan bisa memakan atau berinteraksi dengan konsumsi sayuran.
origins.trait.fire_immunity.name=Kebal Api
origins.trait.fire_immunity.description=Setiap kali kamu menerima kerusakan magma, api, atau lahar, untuk sementara meningkatkan kerusakan yang kamu hasilkan.
origins.trait.nether_spawn.name=Penghuni Nether
origins.trait.nether_spawn.description=Tempat kemunculan alamimu adalah di Nether.
origins.trait.burning_wrath.name=Bara
origins.trait.burning_wrath.description=Saat kamu terbakar, mob apa pun yang kamu pukul dan mob di sekitarnya akan terbakar. Ini hanya dapat dipicu sekali setiap 3 detik.
origins.trait.hotblooded.name=Berdarah Panas
origins.trait.hotblooded.description=Karena tubuhmu yang panas, racun terbakar habis, membuatmu kebal terhadap efek status racun dan kelaparan.
origins.trait.water_vulnerability.name=Hidrofobia
origins.trait.water_vulnerability.description=Kamu menerima kerusakan seiring waktu saat bersentuhan dengan air.
origins.trait.tailwind.name=Angin Buritan
origins.trait.tailwind.description=Kamu sedikit lebih cepat berjalan kaki daripada yang lain, sekaligus dapat berlari lebih efisien.
origins.trait.slow_falling.name=Seberat Bulu
origins.trait.slow_falling.description=Kamu jatuh selembut bulu ke tanah.
origins.trait.vegetarian.name=Vegetarian
origins.trait.vegetarian.description=Dietmu terbatas pada sayuran, dan kamu tidak akan bisa memakan atau berinteraksi dengan konsumsi daging.
origins.trait.fresh_air.name=Udara Segar
origins.trait.fresh_air.description=Saat tidur, tempat tidurmu harus berada di ketinggian setidaknya 151 blok, agar kamu bisa menghirup udara segar.
origins.trait.fresh_air.sleep_fail=Kamu membutuhkan udara segar untuk tidur
origins.trait.phantomize.name=Menjadi Phantom
origins.trait.phantomize.description=Gunakan item kemampuan untuk berubah menjadi mode penonton. Kamu keluar dari kondisi ini saat berdiri diam.
origins.trait.invisibility.name=Tubuh Spiritual
origins.trait.invisibility.description=Saat berada dalam mode penonton, kamu tidak terlihat dari orang lain dan dapat menembus blok, serta tidak dapat berinteraksi dengan apa pun.
origins.trait.burns_in_daylight.name=Undead
origins.trait.burns_in_daylight.description=Kamu mulai terbakar di siang hari jika kamu tidak menghilang atau jika tidak mengenakan helm apa pun.
origins.trait.fall_immunity.name=Pergelangan Kaki Kuat
origins.trait.fall_immunity.description=Kamu tidak pernah menerima kerusakan jatuh, tidak peduli dari ketinggian berapa kamu jatuh.
origins.trait.sprint_jump.name=Akrobatik
origins.trait.sprint_jump.description=Kamu dapat melompat lebih tinggi dengan melompat sambil berlari.
origins.trait.nine_lives.name=Sembilan Nyawa
origins.trait.nine_lives.description=Kamu memiliki kesehatan 1 hati lebih sedikit daripada manusia.
origins.trait.cat_vision.name=Nokturnal
origins.trait.cat_vision.description=Di tempat-tempat dengan tingkat pencahayaan rendah, kamu secara otomatis mendapatkan efek status kekuatan dan penglihatan malam.
origins.trait.weak_arms.name=Lengan Lemah
origins.trait.weak_arms.description=Saat tidak berada di bawah pengaruh kekuatan, kamu menambang blok lebih lambat dan menyerang lebih lemah.
origins.trait.scare_creepers.name=Penampilan Kucing
origins.trait.scare_creepers.description=Creeper takut padamu dan hanya akan meledak jika kamu menyerang mereka terlebih dahulu.
origins.trait.launch_into_air.name=Anugerah Angin
origins.trait.launch_into_air.description=Mendorong dirimu tinggi-tinggi ke udara. Memiliki jeda 30 detik sebelum setiap penggunaan.
origins.trait.elytra.name=Bersayap
origins.trait.elytra.description=Kamu memiliki sayap Elytra tanpa perlu memperlengkapkannya, dan tidak pernah hilang maupun bisa dilepas.
origins.trait.elytra.item_lore=Peralatan Elytrian
origins.trait.light_armor.name=Kebutuhan Mobilitas
origins.trait.light_armor.description=Kamu menjadi berat saat mengenakan bagian zirah yang terbuat dari besi, berlian, atau netherit.
origins.trait.claustrophobia.name=Klaustrofobia
origins.trait.claustrophobia.description=Berada di tempat dengan langit-langit rendah terlalu lama akan melemahkanmu dan membuatmu lebih lambat.
origins.trait.more_kinetic_damage.name=Tulang Rapuh
origins.trait.more_kinetic_damage.description=Kamu menerima lebih banyak kerusakan akibat jatuh dan terbang menabrak blok.
origins.trait.aerial_combatant.name=Petarung Udara
origins.trait.aerial_combatant.description=Kamu menghasilkan lebih banyak kerusakan saat meluncur dengan Elytra.
origins.trait.throw_ender_pearl.name=Teleportasi
origins.trait.throw_ender_pearl.description=Memungkinkanmu bertransportasi secara langsung ke blok yang kamu lihat. Memiliki jeda singkat sebelum setiap penggunaan.
origins.trait.pumpkin_hate.name=Takut Labu
origins.trait.pumpkin_hate.description=Kamu takut pada labu. Untuk alasan yang bagus. Karena itu, jika kamu memiliki item labu di dalam inventaris milikmu, kamu akan mendapatkan efek status kelemahan.
origins.trait.familiar_face.name=Wajah Familiar
origins.trait.familiar_face.description=Monster dan enderman lainnya tidak akan menyerangmu bahkan jika kamu melihat mereka secara langsung tanpa memakai labu ukir, kecuali kamu menyerang mereka terlebih dahulu.
origins.trait.shulk_inventory.name=Penimbun
origins.trait.shulk_inventory.description=Picu kemampuan untuk beralih ke ruang inventaris yang berbeda. Memungkinkanmu menyimpan lebih banyak item dengan 9 slot tambahan yang tetap ada bahkan setelah mati.
origins.trait.natural_armor.name=Kulit Kokoh
origins.trait.natural_armor.description=Bahkan tanpa mengenakan zirah, kulitmu memberikan perlindungan alami sehingga menerima kerusakan 20% lebih sedikit dari sumber mana pun.
origins.trait.more_exhaustion.name=Nafsu Makan Besar
origins.trait.more_exhaustion.description=Kamu mudah lelah, menguras lebih banyak kelaparan dari biasanya.
origins.trait.no_shield.name=Canggung
origins.trait.no_shield.description=Cara tanganmu terbentuk tidak memungkinkan untuk memegang perisai secara tegak. Mencoba menangkis dengan perisai akan segera menghancurkannya tanpa memedulikan sihir yang diterapkan padanya.
origins.trait.strong_arms.name=Lengan Kuat
origins.trait.strong_arms.description=Kamu lebih kuat dan dapat menghancurkan blok batu tanpa memerlukan beliung apa pun.
origins.trait.end_spawn.name=Penghuni End
origins.trait.end_spawn.description=Petualanganmu dimulai di End.
origins.trait.camouflage.name=Kamuflase
origins.trait.camouflage.description=Kamu menyatu dengan lingkungan saat berjongkok, sehingga mob jahat tidak akan menyerangmu secara alami - kecuali jika kamu menyerang mereka terlebih dahulu.
origins.trait.fast_footed.name=Langkah Cepat
origins.trait.fast_footed.description=Karena kakimu yang lebih pendek dan tingkat kelelahan yang rendah, kecepatan gerakanmu meningkat dan ukuran tubuhmu berkurang.
origins.trait.pounce.name=Menerkam
origins.trait.pounce.description=Isi daya item kemampuan dengan menahannya lalu melompat ke arah yang kamu lihat. Semakin lama isi daya, semakin jauh jaraknya.
origins.trait.pounce.charge=Tahan berjongkok untuk mengisi daya menerkam
origins.trait.berry_craver.name=Pecandu Buah Buni
origins.trait.berry_craver.description=Buah buni manis memulihkan lebih banyak poin kelaparan saat dimakan, dan terkadang memberikan efek regenerasi. Kamu juga tidak terluka dari semak buah buni.
origins.trait.smaller_heart.name=Jantung Lebih Kecil
origins.trait.smaller_heart.description=Karena ukuran keseluruhanmu yang lebih kecil, jantungmu lebih kecil, mengakibatkan kesehatan maksimummu berkurang 4 hati.
origins.trait.fast_metabolism.name=Metabolisme Cepat
origins.trait.fast_metabolism.description=Dengan kecepatanmu dan lambung yang lebih kecil, kamu menjadi lebih cepat lapar dari biasanya.
origins.trait.bouncy_body.name=Tubuh Membal
origins.trait.bouncy_body.description=Kamu mengurangi sebagian besar kerusakan jatuh karena tubuhmu yang membal namun lengket.
origins.trait.high_jump.name=Lompatan Super
origins.trait.high_jump.description=Warisan slime milikmu memberimu lompatan yang ditingkatkan, memungkinkanmu melompat lebih tinggi. Mendorong mundur dan memberikan kerusakan pada mob terdekat saat mendarat. Kemampuan pasif ini hanya dapat dipicu sekali setiap 3 detik.
origins.trait.sticky.name=Lengket
origins.trait.sticky.description=Setiap entitas yang menyerangmu dalam jarak dekat menjadi lambat, dan mengurangi kerusakan yang diberikan kepadamu sebesar 10%. Kamu juga terlihat hijau dan berlendir.
origins.trait.fragmentation.name=Fragmentasi
origins.trait.fragmentation.description=Kamu menyusut ke sebagian dari ukuran tubuhmu saat kesehatanmu menurun, begitu pula dengan poin kesehatan maksimum milikmu.
origins.trait.slime_ball_consume.name=Pemulihan
origins.trait.slime_ball_consume.description=Kamu dapat mengonsumsi dan memakan bola slime untuk memulihkan bagian dari dirimu yang hilang.
origins.trait.stress.name=Stres
origins.trait.stress.description=Ini terakumulasi di dalam dirimu dengan laju lambat. Setelah terisi penuh, kamu akan meledak dengan dahsyat - merusak segala sesuatu yang mengelilingimu. Namun, semua waktu tunggu kemampuanmu mendingin lebih cepat jika [Stres] milikmu berada pada 70%.
origins.trait.meditate.name=Bermeditasi
origins.trait.meditate.description=Kurangi [Stres] yang terakumulasi dengan berjongkok, selama kesehatanmu penuh.
origins.trait.cosmic_gift.name=Anugerah Kosmik
origins.trait.cosmic_gift.description=Starborne adalah makhluk yang diberkahi oleh langit. Dipengaruhi oleh gravitasi yang lebih rendah, kamu dapat melompat lebih tinggi dan turun kembali ke tanah dengan anggun - tidak menerima kerusakan jatuh sama sekali.
origins.trait.hyper_leap.name=Lompatan Hiper
origins.trait.hyper_leap.description=Mendorong ke arah tertentu yang kamu lihat, dan meluncurkan entitas yang berada di sekitarmu ke udara. Memiliki jeda singkat sebelum setiap penggunaan.
origins.trait.shooting_star.name=Bintang Jatuh
origins.trait.shooting_star.description=Menembakkan proyektil bintang ke arah yang kamu lihat, merusak mob saat bertabrakan. Memiliki jeda sebelum setiap penggunaan.
origins.trait.no_hitting.name=Tanpa Kekerasan
origins.trait.no_hitting.description=Starborne memiliki peluang menjadi tidak dapat bergerak untuk sementara setiap kali mereka dilukai oleh entitas lain. Dalam kondisi ini, penglihatanmu juga terhalang untuk sementara.
origins.trait.burning.name=Vakum Dingin
origins.trait.burning.description=Starborne terbiasa dengan dinginnya ruang angkasa yang luas, sehingga menerima dua kali lipat kerusakan api - panas yang tidak biasa bagi mereka.
origins.trait.nimble.name=Cepat
origins.trait.nimble.description=Inchling kebal terhadap duri dan kerusakan berbasis kecepatan.
origins.trait.hyper_active.name=Hiperaktif
origins.trait.hyper_active.description=Kamu dapat mengonsumsi gula bahkan jika kenyang, memberikan peningkatan kecepatan gerakan sementara.
origins.trait.small_apetite.name=Nafsu Makan Kecil
origins.trait.small_apetite.description=Mengonsumsi gula sudah cukup untuk kebutuhanmu, karena memberikan efek kejenuhan bertahan lama kepadamu. Membutuhkan lebih sedikit makanan untuk terus melangkah.
origins.trait.bite_sized.name=Ukuran Gigitan
origins.trait.bite_sized.description=Kamu bertali-kali lipat lebih kecil dan memiliki kesehatan 5 hati lebih sedikit dibandingkan manusia biasa.
origins.trait.poison_bonus_damage.name=Fatalitas
origins.trait.poison_bonus_damage.description=Kamu menghasilkan kerusakan 50% lebih banyak pada target yang kamu lukai yang menderita racun mematikan.
origins.trait.sacrifice_stinger.name=Sengat
origins.trait.sacrifice_stinger.description=Kamu membawa hingga 7 sengat sekaligus, dan digunakan setiap kali kamu memberikan kerusakan racun. Setelah semua sengat habis digunakan, kamu ditakdirkan untuk binasa dan mati.
origins.trait.bloom.name=Menyerbuk
origins.trait.bloom.description=Selama siang hari, kamu dapat berdiri di atas bunga apa pun dan berjongkok untuk memulihkan [Sengat] apa pun yang mungkin hilang. Namun, ini akan menghancurkan bunga tersebut.
origins.trait.nighttime.name=Diurnal
origins.trait.nighttime.description=Kamu bekerja paling baik di hari yang cerah, sehingga kamu melemah dan bergerak lambat di malam hari atau jika mulai hujan di siang hari.
origins.trait.lifespan.name=Rentang Hidup Pendek
origins.trait.lifespan.description=Lebah memiliki kesehatan 3 hati lebih sedikit daripada manusia.
origins.trait.nectar_diet.name=Diet Nektar
origins.trait.nectar_diet.description=Kamu tidak dapat memakan makanan biasa, dan hanya bisa mengonsumsi bunga.
origins.trait.pride.name=Kebanggaan
origins.trait.pride.description=Semakin banyak item emas yang kamu bawa di inventaris, dipakai, atau dipegang, semakin sedikit kerusakan yang akan kamu terima dari sumber mana pun. Kamu dapat mengurangi hingga 90% kerusakan yang diterima dengan cara ini.
origins.trait.increased_attack_per_entity.name=Daya Tembak Membanggakan
origins.trait.increased_attack_per_entity.description=Serangan jarak dekatmu memberikan kerusakan tambahan setara dengan 10% dari kerusakan yang telah kamu hasilkan. Lebih meningkatkan kerusakan tambahan yang dihasilkan sebesar 10% per entitas terdekat dalam jarak 6 blok.
origins.trait.gluttony.name=Kerakusan
origins.trait.gluttony.description=Kamu menjadi lebih lapar dari biasanya saat memulihkan kesehatan.
origins.trait.courage.name=Keberanian
origins.trait.courage.description=Kamu kebal dari efek status kelemahan dan wither.
origins.trait.lifeweaver.name=Penjalin Kehidupan
origins.trait.lifeweaver.description=Elven memiliki rentang hidup yang panjang. Saat menerima kerusakan, segera memulihkan setengah dari kerusakan yang diterima. Kemudian, memberikan Penyerapan selama 12 detik yang disesuaikan tergantung pada jumlah kerusakan yang diterima. Kemampuan ini memiliki jeda 2 detik.
origins.trait.endless_quiver.name=Tabung Panah Tak Terbatas
origins.trait.endless_quiver.description=Saat memegang busur di tangan dan kamu tidak memiliki anak panah di inventaris milikmu, secara otomatis memberikan satu untuk dirimu sendiri.
origins.trait.imbued_shots.name=Tembakan Diresapi
origins.trait.imbued_shots.description=Setiap kali proyektil busurmu mengenai makhluk, sebuah bola magis melengkung ke arah target. Serangan susulan ini memberikan kerusakan sihir yang setara dengan kesehatanmu saat ini.
origins.trait.elegant.name=Anggun
origins.trait.elegant.description=Karena sifat rampingmu sebagai seorang Elven, kamu hanya dapat mengenakan zirah ringan seperti kulit. Kamu juga hanya dapat memegang busur sebagai senjata, dan tidak ada yang lain.
origins.trait.swift.name=Lincah
origins.trait.swift.description=Kamu lincah dan cepat, dengan peningkatan kecepatan gerakan, memungkinkanmu melintasi medan tanpa usaha.
origins.trait.permeable.name=Permeabel
origins.trait.permeable.description=Kamu menerima kerusakan 10% lebih banyak.
origins.trait.beelzebub.name=Beelzebub
origins.trait.beelzebub.description=Memanggil kerakusan, serangan jarak dekatmu mengisi daya satu tumpukan [Beelzebub], hingga tiga tumpukan. Kemudian, memberikan kerusakan tambahan berdasarkan kesehatan milikmu yang hilang.
origins.trait.soulburst.name=Ledakan Jiwa
origins.trait.soulburst.description=Lepaskan daya hidup yang diserap. Saat [Beelzebub] mencapai tiga tumpukan, mengonsumsi semuanya, dan memberikan kerusakan tambahan setara dengan kesehatanmu yang hilang saat ini. Kemudian, memulihkan kesehatan setara dengan kesehatan yang hilang saat ini dari entitas yang telah kamu serang.
origins.trait.umbral_veil.name=Tirai Bayangan
origins.trait.umbral_veil.description=Menyelubungi dirimu dalam energi gelap saat berlari, memberikan kecepatan tambahan dan menghindari kerusakan fisik apa pun. Saat berlari, kamu menjadi lapar lebih cepat.
origins.trait.sinister_aura.name=Aura Jahat
origins.trait.sinister_aura.description=Mob ramah di sekitar menjadi takut dengan keberadaanmu, dan akan lari darimu.
origins.trait.life_drain.name=Kuras Kehidupan
origins.trait.life_drain.description=Setiap kali kamu memberikan kerusakan, kesehatanmu berkurang sebesar kesehatan target yang hilang, hingga 50% dari kesehatan maksimum milikmu. Saat kesehatanmu sama dengan 1, ini tidak akan berkurang lebih jauh.
origins.trait.prescience.name=Presains
origins.trait.prescience.description=Kamu dapat melihat takdir orang lain. Gunakan untuk menentukan pemain lain untuk dihubungkan. Kamu dan pemain yang kamu hubungkan akan terikat dan berbagi kumpulan poin kesehatan yang sama, meningkatkan kesehatan kalian berdua sesuai dengan poin kesehatan maksimum yang mereka miliki. Kamu dapat menghubungkan hingga 3 pemain lagi.
origins.trait.prescience.form.hint=Pilih hingga tiga pemain untuk dihubungkan.~LINEBREAK~Mereka harus dekat dan tidak terhalang agar kamu dapat terhubung dengan mereka.~LINEBREAK~
origins.trait.prescience.form.slot=Hubungkan %1
origins.trait.prescience.form.none=(tidak ada)
origins.trait.prescience.form.offline= (Luring)
origins.trait.prescience.form.confirm=Konfirmasi
origins.trait.intervention.name=Intervensi
origins.trait.intervention.description=Memanipulasi dan menjalin bintang-bintang untuk keuntunganmu. Menukar lokasimu dan pemain lain yang terhubung denganmu, jika ada. Ini berfungsi terlepas dari dimensi. Ini memiliki jeda 120 detik.
origins.trait.intervention.form.target=Tukar dengan
origins.trait.intervention.none=Kamu tidak terhubung dengan siapa pun.
origins.trait.intervention.offline=Semua orang yang terhubung denganku sedang luring.
origins.trait.oracle.name=Ramalan
origins.trait.oracle.description=Cari takdir bersama orang lain. Di bawah efek [Presains], kerusakan yang diberikan atau pemulihan yang diterima akan didistribusikan di antara kamu dan pemain yang terhubung denganmu.
origins.trait.aegis.name=Aegis
origins.trait.aegis.description=Memberikan perlindungan dari bahaya. Mencegahmu, dan siapa pun yang terhubung denganmu, dari kerusakan mematikan. Ini memiliki jeda 120 detik.
origins.trait.divine_aura.name=Aura Ilahi
origins.trait.divine_aura.description=Pemain di bawah efek [Presains] akan bersinar, dan dapat terlihat menembus dinding. Namun, kilauan ini akan selalu bertahan padamu.
origins.trait.fragility.name=Kerentanan
origins.trait.fragility.description=Semakin sedikit kesehatan yang kamu miliki, semakin banyak kerusakan yang kamu terima.
origins.trait.instability.name=Ketidakstabilan
origins.trait.instability.description=Untuk setiap efek status unik yang diterapkan padamu, kesehatan maksimum milikmu akan berkurang 1. Saat kesehatanmu sama dengan 1, ini tidak akan berkurang lebih jauh.
origins.trait.burrow_sense.name=Indra Menggali
origins.trait.burrow_sense.description=Gunakan item kemampuan pertama untuk merasakan bijih terdekat yang terkubur di bawah tanah. Disorot oleh garis luar putih.
origins.trait.tunnel_leap.name=Lompatan Terowongan
origins.trait.tunnel_leap.description=Gunakan item kemampuan kedua untuk menerjang ke depan, menghancurkan blok saat kamu melaju.
origins.trait.claw_digging.name=Galian Cakar
origins.trait.claw_digging.description=Saat berada di bawah tanah, kamu dapat menambang tanah, kerikil, batu, dan pasir secara instan dengan tangan kosong.
origins.trait.darkvision.name=Penglihatan Gelap
origins.trait.darkvision.description=Kamu dapat melihat melalui kegelapan di dalam gua.
origins.trait.heavy_bones.name=Tulang Berat
origins.trait.heavy_bones.description=Kamu kesulitan berenang, mengurangi gerakan di air.
origins.trait.compact_size.name=Ukuran Ringkas
origins.trait.compact_size.description=Hitbox milikmu berkurang dan kamu dapat bergerak melalui ruang setinggi 1 blok tanpa berjongkok.
origins.trait.claustrophile.name=Klaustrofil
origins.trait.claustrophile.description=Kamu mendapatkan kekuatan dan regenerasi saat berada di bawah tanah.
origins.trait.photosensitive.name=Peka Cahaya
origins.trait.photosensitive.description=Kamu menerima sedikit kerusakan dan penurun status saat bersentuhan dengan sinar matahari langsung.
origins.trait.poor_swimmer.name=Perenang Buruk
origins.trait.poor_swimmer.description=Kamu kesulitan berenang dan tenggelam di air.
origins.trait.wrathroot.name=Wrathroot
origins.trait.wrathroot.description=Kamu menjadi lebih kuat saat bertarung. Setiap tumpukan [Wrathroot] menambahkan 1 kerusakan pada serangan tangan kosong milikmu. Kamu dapat memegang hingga 7 tumpukan. Kehilangan 1 tumpukan setelah membunuh musuh, dan kehilangan semua tumpukan saat kamu mati.
origins.trait.vine_bind.name=Ikat Sulur
origins.trait.vine_bind.description=Saat kamu memukul musuh, musuh terdekat dalam jarak 32 blok juga dapat dirantai. Musuh dirantai selama 4 detik, dan tidak dapat bergerak dalam durasi ini. Hingga 5 musuh dapat dihubungkan paling banyak. Ini memiliki jeda 6 detik.
origins.trait.vine_bind_power.name=Putus Rantai
origins.trait.vine_bind_power.description=Jika [Ikat Sulur] terhubung ke 5 musuh, ini memberikan kerusakan setara dengan 12% dari total kesehatan mereka. Kemudian, memberimu 1 tumpukan [Wrathroot].
origins.trait.leech_life.name=Sedot Kehidupan
origins.trait.leech_life.description=Jika musuh yang dirantai menerima kerusakan, 25% dari kerusakan tersebut menyebar ke musuh lain dalam rantai.
origins.trait.flammable.name=Mudah Terbakar
origins.trait.flammable.description=Kamu menerima dua kali lipat kerusakan dari api dan lahar.
origins.trait.no_weapon.name=Tangan Kosong
origins.trait.no_weapon.description=Kamu bertarung paling baik dengan tangan kosong. Memegang item atau senjata mengurangi kerusakan milikmu.
origins.trait.bat_form.name=Wujud Kelelawar
origins.trait.bat_form.description=Gunakan kemampuan untuk beralih ke wujud kelelawar, memungkinkanmu untuk terbang. Saat dalam wujud kelelawar, kamu tidak dapat terbakar di siang hari, tetapi juga tidak dapat menyerang maupun menggunakan alat milikmu. Gunakan lagi untuk berubah kembali.
origins.trait.bloodthirsty.name=Haus Darah
origins.trait.bloodthirsty.description=Sebagai Vampir, dietmu terbatas pada meminum darah. Kamu tidak boleh memuaskan kelaparanmu dengan makanan biasa, dan sebaliknya hanya bisa meminum darah. Darah dipulihkan setiap kali kamu memukul makhluk hidup apa pun. Jika darahmu mencapai nol, kamu mendapatkan kelemahan dan akan terus menerus menerima kerusakan.
origins.trait.death_sense.name=Indra Kematian
origins.trait.death_sense.description=Kamu dapat merasakan entitas terdekat di ambang kematian. Menimpakan pemain dan mob dengan kesehatan 20% atau kurang, menjamin kerusakan mematikan yang dapat membunuh mereka.
origins.trait.nocturnal.name=Nokturnal
origins.trait.nocturnal.description=Di malam hari, kamu dapat melihat lebih jelas dengan penglihatan malam, dan kecepatan.
origins.trait.regenerative.name=Regeneratif
origins.trait.regenerative.description=Saat kesehatan tidak penuh, kamu beregenerasi lebih cepat dengan mengorbankan darahmu yang menguras dengan cepat. Namun, kamu tidak dapat beregenerasi saat terbakar.
origins.trait.undead.name=Undead
origins.trait.undead.description=Kondisi undead milikmu membuatmu kebal terhadap racun dan kerusakan pembekuan, tetapi lemah terhadap api dan sinar matahari. Kamu juga tidak harus bernapas di bawah air untuk bertahan hidup.
origins.trait.wrath_of_olympus.name=Murka Olympus
origins.trait.wrath_of_olympus.description=Memanggil Trisula lempar yang kuat di tanganmu, menciptakan ledakan dan merusak mob serta pemain saat bertabrakan. Memiliki jeda 30 detik.
origins.trait.wrath_of_olympus.cast_begin=Lempar trisula ke lokasi target
origins.trait.wrath_of_olympus.cast_cancel=Mantra dibatalkan
origins.trait.wrath_of_olympus.no_sky=Tidak ada langit untuk dipanggil di sini!
origins.trait.divine_ascent.name=Kenaikan Ilahi
origins.trait.divine_ascent.description=Diberkahi dengan kekuatan langit, kamu dapat melompat ganda, mampu melayang dan mengapung di bawah busa awan. Kamu juga kebal dari kerusakan jatuh.
origins.trait.static_energy.name=Energi Statis
origins.trait.static_energy.description=Kekuatan listrik mengalir di dalam dirimu. Menerapkan kelambatan pada mob & pemain yang kamu pukul, yang berlangsung selama 6 detik.
origins.trait.discharge.name=Pelepasan Listrik
origins.trait.discharge.description=Setiap kali kamu memberikan kerusakan pada mob & pemain lain yang diperlambat, ada peluang 30% kamu akan memukau (stun) mereka selama 1-2 detik. Musuh yang terpukau secara tambahan menerima kerusakan kesehatan 3 untuk setiap 2 item logam unik di inventaris milikmu.
origins.trait.surge_protection.name=Pelindung Lonjakan
origins.trait.surge_protection.description=Kamu kebal dari kerusakan petir.
origins.trait.claustrophobic.name=Klaustrofobik
origins.trait.claustrophobic.description=Sebagai Dewa dari langit, kamu tidak terbiasa berada di bawah tanah. Kamu mendapatkan kelemahan kapan pun kamu berada di bawah tanah atau tidak di Overworld.
origins.trait.severed_connection.name=Koneksi Terputus
origins.trait.severed_connection.description=End dan Nether tidak memiliki langit. Kamu tidak dapat memanggil Murka Olympus di dimensi lain selain Overworld.

origins.trait.speedy.name=Cepat
origins.trait.speedy.description=Kamu dapat berjalan, berenang, dan berlari sedikit lebih cepat dari biasanya.
origins.trait.strong.name=Kuat
origins.trait.strong.description=Pukulanmu memberikan kerusakan 1 lebih banyak.
origins.trait.sneaky.name=Diam-diam
origins.trait.sneaky.description=Plat namamu tidak pernah selalu terlihat, bahkan saat kamu tidak berjongkok.
origins.trait.stealth.name=Di Dalam Bayangan
origins.trait.stealth.description=Saat kamu menerapkan efek tidak terlihat, seranganmu berikutnya memberikan lebih banyak kerusakan.
origins.trait.less_bow_slowdown.name=Kelincahan
origins.trait.less_bow_slowdown.description=Kamu dapat bergerak lebih cepat berjalan kaki daripada yang lain saat menarik busur atau busur silang milikmu.
origins.trait.no_projectile_divergence.name=Presisi
origins.trait.no_projectile_divergence.description=Semua anak panah yang kamu tembakkan bergerak dalam garis lurus, tidak terpengaruh oleh gravitasi.
origins.trait.less_shield_slowdown.name=Penggunaan Perisai
origins.trait.less_shield_slowdown.description=Kamu mendapatkan perlindungan tambahan saat menangkis dengan perisai.
origins.trait.less_health_more_attack.name=Dahaga Darah Murka
origins.trait.less_health_more_attack.description=Kamu mendapatkan kekuatan yang meningkat semakin rendah kesehatanmu saat ini.
origins.trait.tamed_animal_boost.name=Teman Satwa
origins.trait.tamed_animal_boost.description=Hewan yang kamu jinakkan menerima penguat permanen pada kesehatan mereka.
origins.trait.effective_empathy.name=Empati Efektif
origins.trait.effective_empathy.description=Setiap efek ramuan yang mungkin kamu miliki juga akan diterapkan pada mob yang telah kamu jinakkan.
origins.trait.more_saturated_food.name=Santapan Lezat
origins.trait.more_saturated_food.description=Makanan yang kamu buat dan masak akan memberikan kelaparan 25% lebih banyak saat dimakan.
origins.trait.more_saturated_food.item_lore=Lebih Mengenyangkan
origins.trait.better_stew.name=Sup Pemulih
origins.trait.better_stew.description=Sup yang kamu buat memberikan efek regenerasi.
origins.trait.better_stew.item_lore=Memberikan Regenerasi
origins.trait.longer_potions.name=Pembuatan Ramuan Mahir
origins.trait.longer_potions.description=Dengan memperpanjang durasi efek ramuan menggunakan batu merah, ramuan apa pun yang kamu buat akan diperpanjang lebih lanjut.
origins.trait.longer_potions.item_lore=Durasi Lebih Lama
origins.trait.powerful_potions.name=Ramuan Kuat
origins.trait.powerful_potions.description=Ramuan apa pun yang kamu buat akan lebih diperkuat saat menyeduhnya dengan batu bercahaya.
origins.trait.powerful_potions.item_lore=Potensi Diperkuat
origins.trait.quality_equipment.name=Keahlian Hebat
origins.trait.quality_equipment.description=Peralatan apa pun yang kamu buat atau tempa akan memiliki peningkatan daya tahan, perlindungan, efisiensi, dan kerusakan.
origins.trait.quality_equipment.item_lore=Atribut Ditingkatkan
origins.trait.efficient_repairs.name=Perbaikan Efisien
origins.trait.efficient_repairs.description=Peralatan berkualitas tinggi yang telah kamu buat lebih mudah diperbaiki dan dapat memulihkan lebih banyak poin daya tahan.
origins.trait.efficient_repairs.item_lore=Mudah Diperbaiki
origins.trait.fast_crop_growth.name=Tangan Dingin
origins.trait.fast_crop_growth.description=Saat menanam tanaman, ada peluang tanaman tersebut akan segera tumbuh.
origins.trait.more_crop_drops.name=Panen Melimpah
origins.trait.more_crop_drops.description=Saat memanen tanaman, kamu terkadang menerima hasil dua kali lipat.
origins.trait.twin_breeding.name=Kelahiran Lebih Banyak
origins.trait.twin_breeding.description=Hewan yang dikembangbiakkan saat kamu berada di sekitar memiliki peluang untuk menghasilkan beberapa bayi.
origins.trait.more_animal_loot.name=Pengumpulan
origins.trait.more_animal_loot.description=Kamu terkadang menerima lebih banyak bahan dari membunuh mob.
origins.trait.cheaper_trades.name=Penawaran Hebat
origins.trait.cheaper_trades.description=Kamu mendapatkan diskon saat berdagang dengan penduduk desa.
origins.trait.wandering_trader_spawn.name=Kharisma
origins.trait.wandering_trader_spawn.description=Pedagang Pengelana lebih mungkin berkunjung saat kamu berada di sekitar.
origins.trait.no_sprint_exhaustion.name=Bugar
origins.trait.no_sprint_exhaustion.description=Kamu tidak kehilangan kelaparan saat berlari.
origins.trait.explorer_kit.name=Kit Penjelajah
origins.trait.explorer_kit.description=Kamu memulai permainan dengan kompas, jam, dan sembilan peta kosong yang tidak akan pernah jatuh saat mati.
origins.trait.ore_vein_miner.name=Penambangan Urat
origins.trait.ore_vein_miner.description=Kamu dapat menambang bijih secara instan dan bijih di sekitarnya saat menggunakan beliung.
origins.trait.no_mining_exhaustion.name=Penggali Veteran
origins.trait.no_mining_exhaustion.description=Kamu tidak kehilangan kelaparan saat menambang.
origins.trait.tree_felling.name=Penebang Pohon Handal
origins.trait.tree_felling.description=Kamu dapat menebang seluruh pohon saat menggunakan kapak.
origins.trait.sapling_setblock.name=Penanaman Kembali
origins.trait.sapling_setblock.description=Ada peluang batang kayu yang kamu hancurkan dapat ditanam kembali dengan jenis bibit pohon yang sama.


