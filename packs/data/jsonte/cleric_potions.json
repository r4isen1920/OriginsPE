	// The three containers a brewed potion can end up in. `factor` scales the
	// derived duration. Vanilla docks splash potions to 0.75; the Cleric's
	// enhanced splashes deliberately drop that penalty and sit at parity with
	// the drinkable. Lingering keeps vanilla's 0.25 per-application value
	// because the cloud reapplies the effect on every stage tick.
	//
	// `brewed_from` and `reagent` mirror vanilla's container chain and drive
	// `packs/BP/recipes/domain/cleric/brewing.r.templ`, so an already-enhanced
	// potion can keep being brewed forward without losing its tier.
	"cleric_potion_deliveries": [
		{
			"id": "potion",
			"lang": "",
			"texture": "potion_bottle",
			"factor": 1.0,
			"throwable": false,
			"entity": null,
			"brewed_from": null,
			"reagent": null
		},
		{
			"id": "splash_potion",
			"lang": ".splash",
			"texture": "potion_bottle_splash",
			"factor": 1.0,
			"throwable": true,
			"entity": "r4isen1920_originspe:cleric_splash_potion",
			"brewed_from": "potion",
			"reagent": "minecraft:gunpowder"
		},
		{
			"id": "lingering_potion",
			"lang": ".linger",
			"texture": "potion_bottle_lingering",
			"factor": 0.25,
			"throwable": true,
